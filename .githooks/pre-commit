#!/bin/sh

echo "Running pre-commit validation..."
if command -v mvn >/dev/null 2>&1; then
    MAVEN_COMMAND="mvn"
elif command -v mvn.cmd >/dev/null 2>&1; then
    MAVEN_COMMAND="mvn.cmd"
elif [ -f "/c/Program Files/NetBeans-25/netbeans/java/maven/bin/mvn.cmd" ]; then
    MAVEN_COMMAND="/c/Program Files/NetBeans-25/netbeans/java/maven/bin/mvn.cmd"
else
    echo "Commit blocked: Maven command was not found."
    exit 1
fi

"$MAVEN_COMMAND" -B clean verify
status=$?

if [ "$status" -ne 0 ]; then
    echo "Commit blocked: Maven validation failed."
    exit "$status"
fi

exit 0
